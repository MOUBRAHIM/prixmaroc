# Copiez ce fichier en .env et remplissez les valeurs

# Application
APP_NAME=PrixMaroc API
DEBUG=false

# Base de données (doit correspondre à docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://prixmaroc:prixmaroc@db:5432/prixmaroc

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — changez obligatoirement en production !
SECRET_KEY=super-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# APIs externes (optionnelles)
GOOGLE_MAPS_KEY=
GOOGLE_VISION_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2 (images scraper)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=prixmaroc-images
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
